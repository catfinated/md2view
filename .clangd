# Compiler configuration
CompileFlags:
  # Add standard flags
  Add: 
    - -std=c++23
    - -Wall
    - -Wextra
    - -Wpedantic
  # Use clang++ as compiler
  Compiler: clang++

# Code completion settings
Completion:
  AllScopes: true

# Diagnostics configuration
Diagnostics:
  # clang-tidy checks come from .clang-tidy (and tests/.clang-tidy). Don't
  # list them here: ClangTidy.Add globs re-enable checks .clang-tidy removes.
  UnusedIncludes: Strict
  MissingIncludes: Strict
  # Keep in sync with misc-include-cleaner.IgnoreHeaders in .clang-tidy
  Includes:
    IgnoreHeader:
      - glm/.*
      - vulkan/vulkan_.*\.hpp
      - vulkan/vulkan_core\.h
      - vulkan/vk_platform\.h
      - fmt/.*
      - boost/.*
  # Suppress unwanted warnings
  Suppress: pragma-pack  

# Index configuration for better performance
Index:
  Background: Build
  StandardLibrary: Yes

# Hover information
Hover:
  ShowAKA: Yes

