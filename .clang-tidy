# cppcoreguidelines-pro-type-union-access is off: GLM implements vector
# components (v.x, v.y, ...) as union members, so every use was flagged.
# cppcoreguidelines-pro-bounds-avoid-unchecked-container-access is off: it
# flags every operator[]. Untrusted input (PCX, MD2) is validated explicitly
# where it is parsed instead.
Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  modernize-*,
  -modernize-use-trailing-return-type,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-init-variables,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  performance-*,
  -performance-no-int-to-ptr,
  readability-*,
  -readability-uppercase-literal-suffix,
  -readability-magic-numbers,
  -readability-identifier-length,
  misc-include-cleaner,
WarningsAsErrors: '*'
HeaderFilterRegex: md2view
CheckOptions:
  - key: cppcoreguidelines-pro-type-member-init.IgnoreArrays
    value: true
  - key: misc-include-cleaner.IgnoreHeaders
    value: 'glm/.*;vulkan/vulkan_.*\.hpp;vulkan/vulkan_core\.h;vulkan/vk_platform\.h;fmt/.*;boost/.*'
  - key: performance-unnecessary-value-param.AllowedTypes
    value: 'gsl_lite::not_null'
